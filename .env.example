# Copy this file to .env and fill in values. NEVER commit .env.
# VerifyLoop reads provider credentials from the environment only.
# The repository never stores key values in configuration files.

# Which adapter to use: mock | ollama | openai_compatible
MODEL_PROVIDER=mock

# Model identifier passed to the provider.
# Examples:
#   mock                     -> mock-scripted
#   ollama                   -> llama3.2:3b (small enough for a 16 GB CPU laptop)
#   ollama                   -> llama3.1:8b (needs substantially more free RAM)
#   ollama (Gemma)           -> gemma3:4b
#   openai_compatible        -> <whatever the endpoint serves>
MODEL_NAME=mock-scripted

# Base URL for ollama / openai-compatible endpoints.
# Local Ollama needs no API key.
MODEL_BASE_URL=http://localhost:11434

# NAME of the environment variable holding the API key (not the key itself).
MODEL_API_KEY_ENV=MODEL_API_KEY

# Put the actual secret here only if you are using .env locally.
# MODEL_API_KEY=

REQUEST_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=900
TEMPERATURE=0.0
MAX_MODEL_CALLS=12
MAX_TOTAL_TOKENS=60000

# Optional: path to the SQLite database and outputs directory.
VERIFYLOOP_DB=outputs/verifyloop.db
VERIFYLOOP_OUTPUTS=outputs
